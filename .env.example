# Database - PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/unicode_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/unicode_db"

# NextAuth - generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email confirmation - Twilio SendGrid
# Verify a Single Sender in SendGrid, then create an Email API key.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="UniCode <your-verified-email@example.com>"

# Judge0 - Code execution engine (optional, uses simulation mode if not set)
# Self-host: https://github.com/judge0/judge0
# Cloud: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_URL="http://localhost:2358"
# JUDGE0_TOKEN=""

# Redis (optional, for BullMQ job queues in production)
# REDIS_URL="redis://localhost:6379"
