# Database - PostgreSQL connection string
# Use the transaction pooler for serverless deployments and the direct URL for migrations.
# Example transaction pooler:
# postgresql://postgres.PROJECT_REF:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:password@localhost:5432/unicode_db"
# Example direct URL:
# postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:password@localhost:5432/unicode_db"

# NextAuth - generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email confirmation - Twilio SendGrid
# Verify a Single Sender in SendGrid, then create an Email API key.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="UniCode <your-verified-email@example.com>"

# Judge0 - Code execution engine (optional, uses simulation mode if not set)
# Self-host: https://github.com/judge0/judge0
# Cloud: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_URL="http://localhost:2358"
# JUDGE0_TOKEN=""

# AI complexity review - OpenRouter free models
# Create a key at https://openrouter.ai and use a free model/router.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_APP_TITLE="UniCode Platform"
# Max extra points awarded from the AI time/space complexity score.
AI_COMPLEXITY_MAX_BONUS=5
AI_COMPLEXITY_TIMEOUT_MS=15000

# Redis (optional, for BullMQ job queues in production)
# REDIS_URL="redis://localhost:6379"
